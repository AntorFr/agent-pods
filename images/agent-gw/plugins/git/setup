#!/bin/sh
# setup du plugin `git` — câble le credential helper sur le hub.
#
# Lancé par le corps à CHAQUE démarrage, et seulement si `git` est dans GW_TOOLS :
# c'est là toute la modularité. Un corps qui n'a pas le droit de publier n'a pas le
# helper, donc `git push` ne trouve aucun credential et échoue — ce qui est le
# comportement voulu, pas un accident.
#
# Pourquoi ici et pas dans un manifeste k8s ni dans une commande tapée à la main :
# les deux commandes de câblage vivaient dans un document de conception, à retaper
# après chaque recréation de pod. Personne ne s'en apercevait avant le premier push
# raté, des jours plus tard. Un setup idempotent versionné avec le binaire qu'il
# câble ne peut pas être oublié.
#
# ⚠️ Le helper est scopé SUR L'HÔTE DU HUB, jamais global. Un helper global
# répondrait aussi pour github.com et prendrait la place du credential légitime.
# Ce n'est pas théorique : `memory-sync` avait exactement ce défaut, corrigé le
# 2026-08-19 par un préfixe d'hôte. (L'outil lui-même a disparu le 2026-08-20 avec
# la sortie de la mémoire hors de git — la leçon, elle, reste.)
set -eu

# Aucun défaut : une URL de hub codée en dur dans une image publique, c'est le
# déploiement de quelqu'un d'autre. Elle se déclare dans le manifeste du pod.
HUB="${HUB_URL:-}"
if [ -z "$HUB" ]; then
    echo "HUB_URL absent : le plugin git ne câble rien (publier échouera)" >&2
    exit 1
fi

# ── Désarmer l'ancien nom, avant de poser le nouveau ────────────────────────
# Le home d'un pod est PERSISTANT : un ~/.gitconfig écrit par une version
# précédente garde `helper rosetta`, qui fait chercher un `git-credential-rosetta`
# désormais absent. Git consulte les helpers dans l'ordre et n'en tire rien : le
# push échoue sur une erreur qui ne parle de rien. On nettoie donc AVANT de poser.
# `|| true` : `--unset-all` sort en 5 quand la clé n'existe pas, ce qui est le cas
# normal sur un home neuf — et `set -e` ferait échouer le setup pour ça.
git config --global --unset-all "credential.${HUB}.helper" 2>/dev/null || true

# Le nom compte : `credential.<hub>.helper hub` fait chercher un exécutable nommé
# git-credential-hub sur le PATH (posé par le bin/ de ce plugin).
git config --global "credential.${HUB}.helper" hub

echo "helper de credential câblé sur ${HUB}"
