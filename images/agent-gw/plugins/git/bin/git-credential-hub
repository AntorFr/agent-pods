#!/usr/bin/env python3
"""git-credential-hub — the credential helper that decides whether a push leaves.

The pod holds NO GitHub credential: it pushes to the hub, which relays to GitHub
with the App token (hub addon `git`). What git needs here is
therefore not a GitHub secret but the pod's own hub token - and handing it over is
exactly the moment where "should this push happen at all?" can still be answered.

Why the guard lives here and not in the hub. A `git push` is a shell command: the
workspace PreToolUse hook only ever sees MCP tool calls, so it cannot see it, and a
header carrying the channel would be forged by the very shell we are guarding. The
credential helper has neither weakness - it is the sole source of the token, so an
agent that bypasses it does not bypass a guard, it ends up with nothing to push
with. Same env, same shield endpoint and same fail-closed posture as the workspace
hook: one mechanism, two call sites.

Channel semantics (identical to google_guard.py, deliberately):

  GW_CHANNEL absent   -> VS Code session, a human is at the keyboard: served.
  GW_CHANNEL=planif   -> clock turn, nobody in front: REFUSED, and no shield can
                         be armed without a witness anyway.
  anything else       -> headless (PWA): one PWA shield consumed per push.

Refusal prints nothing on stdout. Git treats a helper that returns no credential as
"no credential available", so the push fails on authentication rather than on a
mysterious error - and the reason lands on stderr, where the agent reads it.

Standard library only, like mcp-bridge and trace-geom: it must run on the bare
python3 of every agent body image.

Wiring (per repository, or globally in the image):

    git config credential.<hub-url>.helper hub
    git remote set-url origin <hub-url>/git/<owner>/<repo>

Set GIT_TERMINAL_PROMPT=0 alongside it: without a credential git would otherwise
try to prompt, and a prompt in a headless pod is a hang.

Env:
  GW_CHANNEL           channel of the current turn (container env / per-turn env)
  HUB_USER_TOKEN       per-session user token injected by the gateway
  HUB_URL              REQUIRED — base URL of the hub. No default: a hardcoded
                       hostname in a public image is someone's private setup.
  GW_CONSUME_URL       shield endpoint, default http://localhost:8000/api/confirm/consume

The historical `ROSETTA_*` spellings are still read as a fallback.
"""


def env(name: str, default: str = "") -> str:
    """Read `HUB_<name>`, falling back to the historical `ROSETTA_<name>`."""
    import os as _os
    return _os.environ.get("HUB_" + name) \
        or _os.environ.get("ROSETTA_" + name) \
        or default

import os
import sys
import urllib.parse
import urllib.request

HUB_URL = env("URL")
CONSUME_URL = os.environ.get(
    "GW_CONSUME_URL",
    os.environ.get("ALFRED_CONSUME_URL", "http://localhost:8000/api/confirm/consume"),
)

SHIELD_MSG = (
    "Push refusé : aucune autorisation PWA active. Demande à Monsieur de taper le "
    "bouclier 🛡 dans la PWA (valable 120 s), puis relance le push — une seule action "
    "par bouclier."
)
PLANIF_MSG = (
    "Push refusé : tour planifié. Une horloge ne publie pas de code — personne n'est "
    "devant pour armer le bouclier, et rien de ce qu'une horloge décide ne doit devenir "
    "un objet partagé. Ce qui publie se fait en session ordinaire, avec Monsieur."
)
NO_TOKEN_MSG = (
    "Push refusé : HUB_USER_TOKEN absent de ce tour. Le proxy git exige une identité "
    "HUMAINE (le jeton GitHub est rangé par `sub` côté hub) ; une identité machine reçoit "
    "un 403. Pousser depuis une session lancée par la gateway, ou depuis le Mac."
)


def refuse(message: str) -> None:
    sys.stderr.write("git-credential-hub : " + message + "\n")
    sys.exit(1)


def read_request() -> dict:
    """Git feeds the helper `key=value` lines, terminated by a blank line."""
    fields = {}
    for line in sys.stdin:
        line = line.rstrip("\n")
        if not line:
            break
        key, _, value = line.partition("=")
        fields[key] = value
    return fields


def consume_shield() -> bool:
    """Burn one PWA authorisation. Fail-closed: any error means refused."""
    try:
        request = urllib.request.Request(CONSUME_URL, data=b"", method="POST")
        with urllib.request.urlopen(request, timeout=5) as response:
            import json
            return json.loads(response.read()).get("granted") is True
    except Exception:
        return False


def main() -> None:
    action = sys.argv[1] if len(sys.argv) > 1 else ""
    # `store` and `erase` are part of the protocol; this helper is stateless, so it
    # must accept them silently rather than error out mid-push.
    if action != "get":
        return

    request = read_request()

    # Only ever answer for the hub. Git consults helpers for every remote, and a
    # helper that answered for github.com would hand the hub token to the wrong
    # host - and shadow whatever legitimate credential the user has for it.
    wanted_host = request.get("host", "")
    hub_host = urllib.parse.urlsplit(HUB_URL).netloc
    if wanted_host != hub_host:
        return  # silence = "I have nothing for this host", git moves on

    channel = os.environ.get("GW_CHANNEL")
    if channel == "planif":
        refuse(PLANIF_MSG)
    if channel and not consume_shield():
        refuse(SHIELD_MSG)

    token = env("USER_TOKEN").strip()
    if not token:
        refuse(NO_TOKEN_MSG)

    # Basic auth: the hub reads the bearer out of the password field. The username
    # is ignored upstream but must be present, or git re-prompts.
    sys.stdout.write("username=x-access-token\n")
    sys.stdout.write("password=%s\n" % token)


if __name__ == "__main__":
    main()
