#!/usr/bin/env python3
# Byte-identical copy in the other image's bin/ — the docker build context is
# images/<name>, so the file cannot be shared. `bin_test.py` enforces it.
"""mcp-bridge — stdio-to-HTTP MCP relay with OAuth token handling.

Claude Code only supports static headers for HTTP MCP servers, but an MCP hub
wants short-lived OAuth access tokens. This bridge closes the gap: Claude talks
newline-delimited JSON-RPC on stdio (as with any local MCP server), the bridge
forwards every message to the hub over HTTPS and handles the tokens itself, in
memory only.

Two identities, tried in order:
  1. HUB_USER_TOKEN — a per-session USER access token injected by the
     gateway at Claude spawn time (the PWA session rebond). Required by
     user-data addons, accepted everywhere else too.
  2. The body's machine identity (AGENT_CLIENT_ID/SECRET, client_credentials),
     fetched and refreshed against Authelia. Enough for the generic addons.

Standard library only, on purpose: it must run on the bare python3 of every
agent body image, with zero dependency to keep in sync.

Usage:  mcp-bridge <addon>              (e.g. mcp-bridge maps)

Env:
  HUB_USER_TOKEN                         per-session user identity (optional)
  AGENT_CLIENT_ID / AGENT_CLIENT_SECRET  machine identity (OIDC client)
  HUB_URL            REQUIRED — base URL of the MCP hub
  HUB_TOKEN_URL      OIDC token endpoint (required with a machine identity)
  HUB_SCOPE          default mcp

The historical `ROSETTA_*` spellings are still read as a fallback: `rosetta` is
the name of one particular hub deployment, not of this relay. Nothing has a
default pointing at someone's private domain — a public image that guesses a
hostname is a public image that leaks a setup.
"""

def env(name: str, default: str = "") -> str:
    """Read `HUB_<name>`, falling back to the historical `ROSETTA_<name>`."""
    return os.environ.get("HUB_" + name) \
        or os.environ.get("ROSETTA_" + name) \
        or default

import base64
import json
import os
import sys
import threading
import time
import urllib.error
import urllib.request

TIMEOUT = 60.0  # generous: some upstream tools wait on slow provider APIs

USER_TOKEN = env("USER_TOKEN")


class TokenManager:
    """Serves a valid machine bearer token, refreshing it under a lock."""

    def __init__(self):
        self.url = env("TOKEN_URL")
        self.client_id = os.environ.get("AGENT_CLIENT_ID", "")
        self.client_secret = os.environ.get("AGENT_CLIENT_SECRET", "")
        self.scope = env("SCOPE", "mcp")
        self._lock = threading.Lock()
        self._token = ""
        self._expiry = 0.0

    def get(self, force: bool = False) -> str:
        with self._lock:
            if force or not self._token or time.time() >= self._expiry:
                self._refresh()
            return self._token

    def _refresh(self) -> None:
        basic = base64.b64encode(f"{self.client_id}:{self.client_secret}".encode()).decode()
        req = urllib.request.Request(
            self.url,
            data=f"grant_type=client_credentials&scope={self.scope}".encode(),
            headers={
                "Authorization": f"Basic {basic}",
                "Content-Type": "application/x-www-form-urlencoded",
            },
        )
        with urllib.request.urlopen(req, timeout=30) as resp:
            payload = json.load(resp)
        self._token = payload["access_token"]
        # Renew one minute early so an in-flight call never carries a dying token.
        self._expiry = time.time() + max(int(payload.get("expires_in", 3600)) - 60, 60)


def parse_http_response(resp) -> list:
    """One HTTP response -> JSON-RPC messages (plain JSON or SSE data lines)."""
    body = resp.read().decode("utf-8", "replace")
    if not body.strip():
        return []  # 202 Accepted: notification acknowledged, nothing to relay
    if "text/event-stream" in resp.headers.get("Content-Type", ""):
        return [json.loads(line[5:]) for line in body.splitlines() if line.startswith("data:")]
    return [json.loads(body)]


def _http_failure(label: str, exc: urllib.error.HTTPError) -> str:
    try:
        body = exc.read().decode("utf-8", "replace")[:200]
    except Exception:
        body = ""
    return f"HTTP {exc.code} (identité {label}) {body}".strip()


def relay(message: dict, endpoint: str, tokens: TokenManager, out_lock: threading.Lock) -> None:
    data = json.dumps(message).encode()

    def post(token: str):
        req = urllib.request.Request(
            endpoint,
            data=data,
            headers={
                "Authorization": f"Bearer {token}",
                "Content-Type": "application/json",
                "Accept": "application/json, text/event-stream",
            },
        )
        return urllib.request.urlopen(req, timeout=TIMEOUT)

    attempts = []
    if USER_TOKEN:
        attempts.append(("session utilisateur", lambda retry: USER_TOKEN))
    if tokens.client_id:
        attempts.append(("machine", lambda retry: tokens.get(force=retry)))

    replies = None
    failure = "aucune identité configurée (ni HUB_USER_TOKEN ni AGENT_CLIENT_ID)"
    try:
        for label, supply in attempts:
            try:
                resp = post(supply(False))
            except urllib.error.HTTPError as exc:
                if exc.code == 401 and label == "machine":
                    # Stale cached machine token: refresh once, retry.
                    try:
                        resp = post(supply(True))
                    except urllib.error.HTTPError as exc2:
                        failure = _http_failure(label, exc2)
                        continue
                elif exc.code in (401, 403):
                    # Identity rejected (expired session token, machine token on
                    # a user-data addon...): try the next identity.
                    failure = _http_failure(label, exc)
                    continue
                else:
                    raise
            with resp:
                replies = parse_http_response(resp)
            break
    except Exception as exc:  # network, hub down... fail the call, not the bridge
        failure = f"{type(exc).__name__}: {exc}"

    if replies is None:
        if "id" not in message:
            print(f"mcp-bridge: dropped notification: {failure}", file=sys.stderr, flush=True)
            return
        replies = [{
            "jsonrpc": "2.0",
            "id": message["id"],
            "error": {"code": -32000, "message": f"mcp-bridge: {failure}"},
        }]

    with out_lock:
        for reply in replies:
            sys.stdout.write(json.dumps(reply) + "\n")
        sys.stdout.flush()


def main() -> int:
    if len(sys.argv) != 2:
        print("usage: mcp-bridge <addon>", file=sys.stderr)
        return 2
    base = env("URL").rstrip("/")
    if not base:
        # Refuser franchement plutôt que deviner : un défaut codé en dur, c'est
        # le déploiement de quelqu'un d'autre dans une image publique.
        print("mcp-bridge: HUB_URL is required (base URL of the MCP hub)",
              file=sys.stderr)
        return 2
    endpoint = f"{base}/{sys.argv[1]}/"
    tokens = TokenManager()
    out_lock = threading.Lock()

    # One thread per request: a slow upstream call must not block the next one.
    for line in sys.stdin:
        line = line.strip()
        if not line:
            continue
        try:
            message = json.loads(line)
        except json.JSONDecodeError as exc:
            print(f"mcp-bridge: bad JSON from client: {exc}", file=sys.stderr, flush=True)
            continue
        threading.Thread(
            target=relay, args=(message, endpoint, tokens, out_lock), daemon=True
        ).start()
    return 0


if __name__ == "__main__":
    sys.exit(main())
